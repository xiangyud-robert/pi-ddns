# Copy to backend.hcl (gitignored) and fill in your S3 bucket details.
# Then run: terraform init -backend-config=backend.hcl

bucket         = "your-terraform-state-bucket"
key            = "pi-ddns/terraform.tfstate"
region         = "us-west-2"
encrypt        = true
dynamodb_table = "terraform-locks"   # optional but recommended

# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

aws_region      = "us-west-2"
aws_account_id  = "012345678901"                   # your AWS account ID, need to match the AWS CLI profile
hosted_zone_id  = "Z1D633PJN98FT9"                 # your Route53 hosted zone ID
record_names    = ["home.example.com", "vpn.example.com"]
                                                   # A records to keep updated (all set to the same IP)
api_domain_name = "ddns-api.example.com"           # custom domain for the API Gateway endpoint
ttl             = 60

# API Gateway rate limits
api_throttle_rate_limit  = 1    # requests/second (steady state)
api_throttle_burst_limit = 1    # concurrent burst
api_quota_limit          = 300  # max requests per day

# GitHub OIDC
github_org  = "your-github-username"
github_repo = "your-fork-name-for-pi-ddns"
tf_state_bucket = "your-pi-ddns-terraform-state-bucket"
